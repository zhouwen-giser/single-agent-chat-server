{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sacs:real-e2e-report:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "track",
    "sourceSha",
    "environmentFingerprint",
    "cases",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sacs-real-e2e-report/1.0"
    },
    "track": {
      "enum": [
        "V0_4",
        "V0_5"
      ]
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environmentFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "status",
          "evidence"
        ],
        "properties": {
          "caseId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED"
            ]
          },
          "evidence": {
            "type": "array"
          }
        }
      }
    },
    "decision": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    }
  }
}
