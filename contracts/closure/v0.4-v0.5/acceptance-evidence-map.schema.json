{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sacs:v04-v05-acceptance-evidence-map:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sacs-v04-v05-acceptance-evidence-map/1.0"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "acceptanceId",
          "status",
          "evidence"
        ],
        "properties": {
          "acceptanceId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED"
            ]
          },
          "evidence": {
            "type": "array"
          }
        }
      }
    }
  }
}
