{
  "$id": "https://schemas.sacs.local/v0.3/completed-request-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompletedRequestResult",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "taskId", "contextId"],
      "properties": {
        "kind": { "const": "task" },
        "taskId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "contextId": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "messageId", "message", "renderedText"],
      "properties": {
        "kind": { "const": "message" },
        "messageId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "relatedTaskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contextId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": ["messageId", "role", "parts"],
          "properties": {
            "messageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "taskId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "contextId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "role": { "const": "AGENT" },
            "parts": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "mediaType", "text"],
                    "properties": {
                      "kind": { "const": "text" },
                      "mediaType": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "text": { "type": "string", "maxLength": 65536 }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "mediaType", "data"],
                    "properties": {
                      "kind": { "const": "data" },
                      "mediaType": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "data": {}
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "mediaType", "url"],
                    "properties": {
                      "kind": { "const": "url" },
                      "mediaType": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "url": {
                        "type": "string",
                        "pattern": "^https?://",
                        "maxLength": 2048
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "renderedText": { "type": "string", "maxLength": 65536 }
      }
    }
  ]
}
