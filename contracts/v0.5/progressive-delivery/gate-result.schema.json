{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gateId", "track", "status", "checks"],
  "properties": {
    "schemaVersion": { "const": "sacs-v05-gate-result/1.0" },
    "gateId": { "type": "string", "minLength": 1 },
    "track": { "enum": ["DEVELOPMENT", "INTEGRATION", "RELEASE"] },
    "status": { "enum": ["PASS", "FAIL", "PENDING", "NOT_RUN"] },
    "source": {
      "$ref": "#/$defs/source"
    },
    "verificationRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "runId",
        "startedAt",
        "finishedAt",
        "source",
        "commands",
        "evidenceDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "sacs-v05-development-run-evidence/1.0"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "source": { "$ref": "#/$defs/developmentSource" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/developmentCommandEvidence" }
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "headSha"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "worktreeDigestAlgorithm": {
          "const": "sacs-v05-git-worktree-content/1.0"
        },
        "worktreeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "worktreeExclusions": {
          "type": "array",
          "prefixItems": [
            {
              "const": "reports/v0.5/progressive/DEVELOPMENT_VERIFICATION.json"
            },
            {
              "const": "reports/v0.5/progressive/INTEGRATION_STATUS.json"
            },
            {
              "const": "reports/v0.5/progressive/PROGRESSIVE_STATUS.json"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "developmentSource": {
      "allOf": [
        { "$ref": "#/$defs/source" },
        {
          "required": [
            "worktreeDigestAlgorithm",
            "worktreeDigest",
            "worktreeExclusions"
          ]
        }
      ]
    },
    "developmentCommandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "executable",
        "arguments",
        "exitCode",
        "status",
        "startedAt",
        "finishedAt",
        "sourceBefore",
        "sourceAfter"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "executable": { "enum": ["node", "pnpm"] },
        "arguments": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
        "status": { "enum": ["PASS", "FAIL"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "sourceBefore": { "$ref": "#/$defs/developmentSource" },
        "sourceAfter": { "$ref": "#/$defs/developmentSource" }
      }
    }
  }
}
