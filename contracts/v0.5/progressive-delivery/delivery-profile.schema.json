{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultProfile", "profiles"],
  "properties": {
    "schemaVersion": { "const": "sacs-v05-delivery-profile/1.0" },
    "defaultProfile": { "const": "DEVELOPMENT" },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "completionMarker", "externalDependencyPolicy"],
        "properties": {
          "profile": { "enum": ["DEVELOPMENT", "INTEGRATION", "RELEASE"] },
          "completionMarker": { "type": "string", "minLength": 1 },
          "externalDependencyPolicy": {
            "enum": ["NOT_APPLICABLE", "PENDING_NOT_BLOCKING", "REQUIRED"]
          }
        }
      }
    }
  }
}
