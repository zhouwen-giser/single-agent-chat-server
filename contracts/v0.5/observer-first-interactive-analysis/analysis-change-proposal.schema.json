{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sacs:analysis-change-proposal:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commandId",
    "proposalId",
    "analysisId",
    "expectedRevisionId",
    "expectedRevisionNumber",
    "targetNodeId",
    "publicArgsHash",
    "editSchemaHash",
    "patch",
    "mode",
    "idempotencyKey",
    "status",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sacs-analysis-change-proposal/1.0"
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "proposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "analysisId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "expectedRevisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "expectedRevisionNumber": {
      "type": "integer",
      "minimum": 0
    },
    "targetNodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "publicArgsHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "editSchemaHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "patch": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "path"
        ],
        "properties": {
          "op": {
            "enum": [
              "add",
              "remove",
              "replace",
              "test"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {}
        }
      }
    },
    "mode": {
      "enum": [
        "SUGGEST_NEXT_REVISION",
        "INTERRUPT_AND_APPLY"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "enum": [
        "SUBMITTED",
        "VALIDATING",
        "REJECTED",
        "CONFLICT",
        "ACCEPTED",
        "COMPILING",
        "COMPILE_FAILED",
        "COMPILED",
        "APPLIED"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "appliedRevisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
