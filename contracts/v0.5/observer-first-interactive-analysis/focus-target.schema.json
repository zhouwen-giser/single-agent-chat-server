{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sacs:focus-target:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "focusId",
    "targetKind",
    "semanticRole",
    "currentness"
  ],
  "properties": {
    "focusId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "targetKind": {
      "enum": [
        "WORLD_REFERENCE",
        "FINDING_FEATURE",
        "TOOL_INPUT",
        "TOOL_OUTPUT",
        "TASK_OBJECT",
        "USER_GEOMETRY"
      ]
    },
    "referenceKey": {
      "type": "object"
    },
    "findingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "featureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "analysisNodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "layerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "semanticRole": {
      "enum": [
        "SUBJECT",
        "ANCHOR",
        "TARGET",
        "QUERY_SCOPE",
        "CANDIDATE",
        "SELECTED_RESULT",
        "EXCLUDED",
        "WARNING"
      ]
    },
    "displayName": {
      "type": "string",
      "maxLength": 512
    },
    "currentness": {
      "enum": [
        "CURRENT",
        "STALE",
        "UNKNOWN"
      ]
    },
    "validTime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
