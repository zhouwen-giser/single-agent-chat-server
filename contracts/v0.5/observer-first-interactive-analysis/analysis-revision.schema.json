{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sacs:analysis-revision:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revisionId",
    "analysisId",
    "revisionNumber",
    "cause",
    "wsgsPlanId",
    "planHash",
    "changedPaths",
    "reusedNodeIds",
    "invalidatedNodeIds",
    "rerunNodeIds",
    "status",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sacs-analysis-revision/1.0"
    },
    "revisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "analysisId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revisionNumber": {
      "type": "integer",
      "minimum": 0
    },
    "parentRevisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "parentRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "cause": {
      "enum": [
        "INITIAL_QUERY",
        "USER_PROPOSAL",
        "USER_INTERVENTION",
        "AMBIGUITY_RESOLUTION",
        "SOURCE_ADVANCED",
        "AUTOMATIC_RETRY"
      ]
    },
    "wsgsPlanId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "planHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "changedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/"
      },
      "maxItems": 128
    },
    "reusedNodeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "maxItems": 256
    },
    "invalidatedNodeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "maxItems": 256
    },
    "rerunNodeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "maxItems": 256
    },
    "status": {
      "enum": [
        "COMPILING",
        "READY",
        "QUEUED",
        "RUNNING",
        "SUPERSEDED",
        "COMPLETED",
        "PARTIAL",
        "FAILED"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
