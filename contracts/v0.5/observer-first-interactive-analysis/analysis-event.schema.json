{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sacs:analysis-event:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "analysisId",
    "revisionId",
    "runId",
    "analysisSequence",
    "runSequence",
    "eventType",
    "correlationId",
    "occurredAt",
    "payload",
    "payloadHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sacs-analysis-event/1.0"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "analysisId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "analysisSequence": {
      "type": "integer",
      "minimum": 1
    },
    "runSequence": {
      "type": "integer",
      "minimum": 1
    },
    "upstreamSequence": {
      "type": "integer",
      "minimum": 1
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "causationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
