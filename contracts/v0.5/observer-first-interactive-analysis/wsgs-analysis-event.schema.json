{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sacs:wsgs-analysis-event:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "upstreamAnalysisId",
    "planId",
    "planHash",
    "planRevision",
    "sequence",
    "eventType",
    "correlationId",
    "occurredAt",
    "payload",
    "payloadHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sacs-wsgs-analysis-event/1.0"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "upstreamAnalysisId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "planHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "planRevision": {
      "type": "integer",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "eventType": {
      "enum": [
        "PLAN_PUBLISHED",
        "NODE_READY",
        "NODE_STARTED",
        "NODE_PROGRESS",
        "TOOL_INTERACTION_PUBLISHED",
        "TOOL_COMPLETED",
        "TOOL_FAILED",
        "MAP_ARTIFACT_AVAILABLE",
        "FINDING_AVAILABLE",
        "INTERVENTION_REQUIRED",
        "ANALYSIS_COMPLETED"
      ]
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "causationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
