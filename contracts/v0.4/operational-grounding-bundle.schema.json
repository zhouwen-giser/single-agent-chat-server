{
  "$id": "https://schemas.sacs.local/v0.4/operational-grounding-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperationalGroundingBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "purpose",
    "groundingId",
    "groundingResultHash",
    "references",
    "evidenceItemIds",
    "ambiguityPolicy",
    "validation",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "purpose": { "const": "SDAR_OPERATION" },
    "groundingId": { "$ref": "#/$defs/identifier" },
    "groundingResultHash": { "$ref": "#/$defs/sha256" },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "referenceKey",
          "sourceWorldVersion",
          "validUntil",
          "revalidationRequired",
          "validationStatus",
          "confirmationStatus"
        ],
        "properties": {
          "productId": { "$ref": "#/$defs/identifier" },
          "referenceKey": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "kind", "id", "version"],
            "properties": {
              "namespace": { "const": "gowm" },
              "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
              "id": { "type": "string", "pattern": "^wrf_[0-9a-f]{32}$" },
              "version": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          },
          "sourceWorldVersion": { "type": "integer", "minimum": 0 },
          "validUntil": { "type": "string", "format": "date-time" },
          "revalidationRequired": { "const": false },
          "validationStatus": { "const": "VALIDATED" },
          "confirmationStatus": {
            "enum": ["NOT_REQUIRED", "EXPLICITLY_CONFIRMED"]
          }
        }
      }
    },
    "evidenceItemIds": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "ambiguityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "autoAcceptSuggestedUnique"],
      "properties": {
        "outcome": { "enum": ["NO_AMBIGUITY", "EXPLICITLY_CONFIRMED"] },
        "autoAcceptSuggestedUnique": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "operation",
        "validatedAt",
        "validationResultHash"
      ],
      "properties": {
        "authority": { "const": "WSGS" },
        "operation": { "const": "VALIDATE_REFERENCES" },
        "validatedAt": { "type": "string", "format": "date-time" },
        "validationResultHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
