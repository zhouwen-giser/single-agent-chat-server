{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sacs:world-focus-explanation-projection:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "explanationId",
    "explanationHash",
    "groundingId",
    "groundingResultHash",
    "findingLinks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sacs-world-focus-explanation/1.0"
    },
    "explanationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "explanationHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "groundingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "groundingResultHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "findingLinks": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "ordinal"],
        "properties": {
          "findingId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "referenceKey": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "kind", "id", "version"],
            "properties": {
              "namespace": {
                "const": "gowm"
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "id": {
                "type": "string",
                "pattern": "^wrf_[0-9a-f]{32}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    }
  }
}
