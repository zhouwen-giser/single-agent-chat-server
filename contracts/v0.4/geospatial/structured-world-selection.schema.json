{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sacs:structured-world-selection:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "selectionId",
    "principalId",
    "threadId",
    "groundingId",
    "explanationId",
    "selectionKind",
    "selectionRevision",
    "sourceHash",
    "selectedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sacs-structured-world-selection/1.0"
    },
    "selectionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "principalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "threadId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "groundingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "explanationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "selectionKind": {
      "enum": ["FINDING_FEATURE", "MAP_FEATURE", "REFERENCE_SET_MEMBER"]
    },
    "findingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "featureId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "referenceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "kind", "id", "version"],
      "properties": {
        "namespace": {
          "const": "gowm"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "id": {
          "type": "string",
          "pattern": "^wrf_[0-9a-f]{32}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "upstreamSelectionToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "selectionRevision": {
      "type": "integer",
      "minimum": 1
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "oneOf": [
    {
      "required": ["referenceKey"],
      "not": {
        "required": ["upstreamSelectionToken"]
      }
    },
    {
      "required": ["upstreamSelectionToken"],
      "not": {
        "required": ["referenceKey"]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "selectionKind": {
            "enum": ["FINDING_FEATURE", "MAP_FEATURE"]
          }
        },
        "required": ["selectionKind"]
      },
      "then": {
        "required": ["findingId"]
      }
    },
    {
      "if": {
        "properties": {
          "selectionKind": {
            "enum": ["FINDING_FEATURE", "MAP_FEATURE"]
          }
        },
        "required": ["selectionKind"]
      },
      "then": {
        "required": ["featureId"]
      }
    }
  ]
}
