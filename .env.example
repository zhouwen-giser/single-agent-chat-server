# LangSmith is optional for local Studio debugging and is not a production dependency.
LANGSMITH_TRACING=false

# Phase 1 server configuration. Replace the development-only value.
CHAT_SERVER_SERVICE_KEY=replace-with-at-least-32-random-characters
AG_UI_SERVICE_KEY=replace-with-a-different-at-least-32-character-secret
# Must exactly match Open WebUI FORWARD_USER_INFO_HEADER_JWT_SECRET.
OPENWEBUI_USER_JWT_SECRET=replace-with-another-at-least-32-character-secret
CHAT_SERVER_HOST=127.0.0.1
CHAT_SERVER_PORT=3000
CHAT_SERVER_BODY_LIMIT_BYTES=1048576
CHAT_SERVER_REQUEST_TIMEOUT_MS=30000
# Empty denies browser cross-origin requests. Set exact comma-separated origins only.
CHAT_CORS_ALLOW_ORIGINS=
CHAT_RATE_LIMIT_MAX=60
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_MAX_MESSAGES=64
CHAT_MAX_MESSAGE_CHARS=32768
LOG_LEVEL=info
CHAT_HTTP_STREAM_BUDGET_MS=30000
SDAR_POLLING_BUDGET_MS=5000
SDAR_POLLING_INTERVAL_MS=1000

# Required in production. The endpoint and model are fixed at startup and are
# never derived from request content. API key may be empty for trusted gateways.
CONVERSATION_MODEL_BASE_URL=http://127.0.0.1:8000/v1
CONVERSATION_MODEL_NAME=general-chat-model
CONVERSATION_MODEL_API_KEY=
CONVERSATION_MODEL_TIMEOUT_MS=30000
CONVERSATION_MODEL_MAX_OUTPUT_TOKENS=2048
CONVERSATION_MODEL_TEMPERATURE=0
CONVERSATION_MODEL_MAX_RETRIES=1
CONVERSATION_MODEL_RESPONSE_FORMAT=json_schema

# Bounded durable context assembly. The current user turn is supplied separately
# and is never dropped by context truncation.
CONVERSATION_MAX_RECENT_MESSAGES=30
CONVERSATION_MAX_CONTEXT_CHARS=60000
CONVERSATION_SUMMARY_TRIGGER_CHARS=45000
CONVERSATION_MAX_TASK_SUMMARY_CHARS=1000

# Phase 4 PostgreSQL persistence and LangGraph checkpoints.
DATABASE_URL=postgresql://single_agent_chat:change-me@127.0.0.1:5432/single_agent_chat
DATABASE_POOL_MAX=10
DATABASE_OPERATION_TIMEOUT_MS=5000
IDEMPOTENCY_LEASE_MS=60000
CHAT_MAX_ACTIVE_TASKS_PER_CHAT=8

# Phase 3 single-SDAR A2A 1.0 HTTP+JSON adapter.
SDAR_A2A_BASE_URL=http://127.0.0.1:9999
# Set only when the validated Agent Card advertises an unusable container URL.
# The adapter never silently rewrites the selected endpoint.
SDAR_A2A_ENDPOINT_OVERRIDE=
SDAR_A2A_DISCOVERY_TIMEOUT_MS=10000
SDAR_A2A_OPERATION_TIMEOUT_MS=30000
