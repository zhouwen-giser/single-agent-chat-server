# LangSmith is optional for local Studio debugging and is not a production dependency.
LANGSMITH_TRACING=false

# Phase 1 server configuration. Replace the development-only value.
CHAT_SERVER_SERVICE_KEY=replace-with-at-least-32-random-characters
CHAT_SERVER_HOST=127.0.0.1
CHAT_SERVER_PORT=3000
CHAT_SERVER_BODY_LIMIT_BYTES=1048576
CHAT_SERVER_REQUEST_TIMEOUT_MS=30000
