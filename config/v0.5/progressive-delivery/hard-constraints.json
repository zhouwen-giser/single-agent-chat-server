{
  "schemaVersion": "sacs-v05-hard-constraints/1.0",
  "constraints": [
    "AUTHENTICATE_ANALYSIS_WRITES",
    "PRINCIPAL_THREAD_OWNERSHIP",
    "NO_CREDENTIAL_OR_INTERNAL_ASSET_LEAK",
    "NO_DESTRUCTIVE_MIGRATION",
    "NO_DIRECT_DOWNSTREAM_DATABASE_ACCESS",
    "NO_DIRECT_EXECUTION_OF_CLIENT_PUBLIC_ARGS",
    "IMMUTABLE_ANALYSIS_REVISION",
    "MAP_DRAFT_NON_AUTHORITATIVE",
    "DATA_GAP_NOT_FALSE",
    "GEOSPATIAL_FINDING_DOES_NOT_OVERRIDE_TASK_AUTHORITY"
  ],
  "globalBlockAllowedOnlyForConstraintFailure": true
}
