{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sacs:v0.6:acceptance-ledger",
  "title": "SACS v0.6 Acceptance Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceSha",
    "updatedAt",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sacs-v06-acceptance-ledger/1.0"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^V06-S[0-9]{2}-[0-9]{3}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED_EXTERNAL",
              "NOT_RUN",
              "NOT_REQUESTED"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reasonCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "safeDetail": {
            "type": "string",
            "maxLength": 2000
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
