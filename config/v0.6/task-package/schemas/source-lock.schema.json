{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sacs:v0.6:source-lock",
  "title": "SACS v0.6 Source Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capturedAt",
    "taskPackage",
    "sacs",
    "wsgs",
    "toolchain",
    "worktree"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sacs-v06-source-lock/1.0"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "taskPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "verified"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verified": {
          "const": true
        }
      }
    },
    "sacs": {
      "$ref": "#/$defs/source"
    },
    "wsgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "commit",
        "treeStatus",
        "contractArtifacts"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/gitSha"
        },
        "treeStatus": {
          "enum": [
            "CLEAN",
            "DIRTY_PRESERVED"
          ]
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "contractArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean",
        "statusDigest"
      ],
      "properties": {
        "clean": {
          "type": "boolean"
        },
        "statusDigest": {
          "$ref": "#/$defs/sha256"
        },
        "preservedChanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "commit",
        "treeStatus"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/gitSha"
        },
        "treeStatus": {
          "enum": [
            "CLEAN",
            "DIRTY_PRESERVED"
          ]
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
