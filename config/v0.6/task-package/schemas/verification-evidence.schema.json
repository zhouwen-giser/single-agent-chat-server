{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sacs:v0.6:verification-evidence",
  "title": "SACS v0.6 Verification Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "track",
    "source",
    "startedAt",
    "finishedAt",
    "commands",
    "acceptanceIds",
    "decision",
    "evidenceDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sacs-v06-verification-evidence/1.0"
    },
    "track": {
      "enum": [
        "DEVELOPMENT",
        "REAL_WSGS_INTEGRATION",
        "RELEASE"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "commit",
        "worktreeDigest"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktreeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exitCode",
          "outputDigest"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exitCode": {
            "type": "integer"
          },
          "outputDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "evidencePaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "acceptanceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^V06-S[0-9]{2}-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "decision": {
      "enum": [
        "PASS",
        "FAIL",
        "PENDING",
        "NOT_REQUESTED"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "safeDetail"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "safeDetail": {
            "type": "string"
          }
        }
      }
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
