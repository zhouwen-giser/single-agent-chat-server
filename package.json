{
  "name": "single-agent-chat-server",
  "version": "0.1.0",
  "description": "OpenAI-compatible conversational entrance for one SDAR A2A agent.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": "\u003e=22.14.0 \u003c23",
    "pnpm": "\u003e=11.13.1 \u003c12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPattern=\\.unit\\.test\\.ts$",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPattern=\\.int\\.test\\.ts$",
    "lint": "eslint apps packages src tests",
    "lint:langgraph-json": "node scripts/check-langgraph-paths.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:graph": "langgraph dev --no-browser",
    "verify:phase0": "pnpm format:check \u0026\u0026 pnpm lint \u0026\u0026 pnpm lint:langgraph-json \u0026\u0026 pnpm typecheck \u0026\u0026 pnpm test:unit \u0026\u0026 pnpm test:integration \u0026\u0026 pnpm build",
    "start": "node dist/apps/server/src/main.js",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "test:contract": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPattern=\\.contract\\.test\\.ts$",
    "verify:phase1": "pnpm format:check \u0026\u0026 pnpm lint \u0026\u0026 pnpm lint:langgraph-json \u0026\u0026 pnpm typecheck \u0026\u0026 pnpm test:unit \u0026\u0026 pnpm test:contract \u0026\u0026 pnpm test:integration \u0026\u0026 pnpm build",
    "verify:phase2": "pnpm format:check \u0026\u0026 pnpm lint \u0026\u0026 pnpm lint:langgraph-json \u0026\u0026 pnpm typecheck \u0026\u0026 pnpm test:unit \u0026\u0026 pnpm test:contract \u0026\u0026 pnpm test:integration \u0026\u0026 pnpm build"
  },
  "dependencies": {
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "zod": "4.4.3",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@langchain/langgraph-cli": "1.4.3",
    "@tsconfig/recommended": "1.0.13",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.11",
    "@typescript-eslint/eslint-plugin": "5.59.8",
    "@typescript-eslint/parser": "5.59.8",
    "dotenv": "17.4.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-no-instanceof": "1.0.1",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "29.7.0",
    "prettier": "3.9.5",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3",
    "tsx": "4.23.0"
  }
}
