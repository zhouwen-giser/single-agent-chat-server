{
  "name": "single-agent-chat-server",
  "version": "0.1.0",
  "description": "OpenAI-compatible conversational entrance for one SDAR A2A agent.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": ">=11.13.1 <12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=\\.int\\.test\\.ts$",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPattern=\\.int\\.test\\.ts$",
    "lint": "eslint src tests",
    "lint:langgraph-json": "node scripts/check-langgraph-paths.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:graph": "langgraph dev --no-browser",
    "verify:phase0": "pnpm format:check && pnpm lint && pnpm lint:langgraph-json && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm build"
  },
  "dependencies": {
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@langchain/langgraph-cli": "1.4.3",
    "@tsconfig/recommended": "1.0.13",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.11",
    "@typescript-eslint/eslint-plugin": "5.59.8",
    "@typescript-eslint/parser": "5.59.8",
    "dotenv": "17.4.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-no-instanceof": "1.0.1",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "29.7.0",
    "prettier": "3.9.5",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3"
  }
}
